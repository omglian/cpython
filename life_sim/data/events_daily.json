[
 {"id": "evt_hm_200", "text": "你在打印店排队时，前面的人回头问你会不会用这台机器。你其实也不会，但你们一起研究明白了。", "domain": "social", "valence": 1, "min_age": 16, "max_age": 60, "weight": 0.7, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_201", "text": "你把用了六年的水杯摔碎了。买了个新的，却总觉得水的味道不太一样。", "domain": "misc", "valence": -1, "min_age": 18, "max_age": 80, "weight": 0.7, "effects": {"happiness": -2}, "source": "handmade"},
 {"id": "evt_hm_202", "text": "你终于把堆了半年的快递纸箱拆完扔掉，房间空出一角，心里也空出一块。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 60, "weight": 0.7, "trait_bias": {"C": 0.3}, "effects": {"happiness": 2, "stress": -2}, "source": "handmade"},
 {"id": "evt_hm_203", "text": "楼下新开了一家面馆，你成了第一批常客。老板第三次见你就知道你要加蛋。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 75, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_204", "text": "你在超市抢到了最后一盒打折的车厘子，推着购物车走路带风。", "domain": "finance", "valence": 1, "min_age": 18, "max_age": 75, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_205", "text": "你给自己做了顿丰盛的饭，摆好盘拍了照，然后一个人安安静静吃完了。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 70, "weight": 0.7, "trait_bias": {"E": -0.3}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_206", "text": "你把攒了很久的话在心里排练了三遍，最后只发出去一句'在忙吗'。", "domain": "social", "valence": -1, "min_age": 16, "max_age": 50, "weight": 0.7, "trait_bias": {"N": 0.4}, "effects": {"stress": 3}, "source": "handmade"},
 {"id": "evt_hm_207", "text": "你终于取关了那些让你焦虑的账号，刷手机的时间少了一半。", "domain": "health", "valence": 1, "min_age": 16, "max_age": 55, "weight": 0.7, "trait_bias": {"N": 0.3}, "effects": {"stress": -5, "happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_208", "text": "同事请了长假去徒步，回来晒黑了一圈。你一边说'真好'，一边默默打开了地图。", "domain": "career", "valence": 0, "min_age": 22, "max_age": 50, "weight": 0.7, "trait_bias": {"O": 0.4}, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_209", "text": "你被拉去凑数打了场球，输得很惨，但出汗的感觉久违地好。", "domain": "health", "valence": 1, "min_age": 15, "max_age": 50, "weight": 0.7, "trait_bias": {"E": 0.3}, "effects": {"happiness": 3, "health": 1}, "source": "handmade"},
 {"id": "evt_hm_210", "text": "你在旧书店淘到一本绝版书，扉页上有前主人写的一行字。", "domain": "growth", "valence": 1, "min_age": 16, "max_age": 75, "weight": 0.6, "trait_bias": {"O": 0.5}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_211", "text": "你连着三天早起，第四天闹钟响的时候，你居然是自己先醒的。", "domain": "health", "valence": 1, "min_age": 15, "max_age": 60, "weight": 0.7, "trait_bias": {"C": 0.4}, "effects": {"happiness": 3, "health": 1}, "source": "handmade"},
 {"id": "evt_hm_212", "text": "你精心准备的生日惊喜提前被剧透了。对方还是很配合地演完了整场惊喜。", "domain": "romance", "valence": 1, "min_age": 18, "max_age": 60, "weight": 0.6, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_213", "text": "你在通讯录里翻到一个再也不会拨出去的号码，犹豫很久，没有删。", "domain": "romance", "valence": -1, "min_age": 20, "max_age": 60, "weight": 0.7, "trait_bias": {"N": 0.3}, "effects": {"happiness": -3}, "source": "handmade"},
 {"id": "evt_hm_214", "text": "你和伴侣周末哪也没去，各自窝在沙发两头看书，一下午没说几句话，很舒服。", "domain": "romance", "valence": 2, "min_age": 22, "max_age": 75, "weight": 0.8, "effects": {"happiness": 4, "stress": -3}, "source": "handmade"},
 {"id": "evt_hm_215", "text": "你在朋友的婚礼上被点名发言，紧张得手心出汗，说完全场居然鼓掌了。", "domain": "social", "valence": 1, "min_age": 22, "max_age": 45, "weight": 0.6, "trait_bias": {"E": 0.3}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_216", "text": "你答应帮朋友搬家，搬到一半开始后悔，晚上那顿饭却吃得格外香。", "domain": "social", "valence": 1, "min_age": 18, "max_age": 50, "weight": 0.7, "trait_bias": {"A": 0.4}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_217", "text": "你养了很久的绿植第一次开花，你专门发了个朋友圈，只有三个人点赞。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 80, "weight": 0.6, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_218", "text": "你在深夜的便利店碰到同样穿着睡衣的邻居，你们默契地假装没看见对方。", "domain": "misc", "valence": 0, "min_age": 18, "max_age": 60, "weight": 0.6, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_219", "text": "你的工位换到了靠窗的位置，午后阳光正好，效率却低了不少。", "domain": "career", "valence": 1, "min_age": 22, "max_age": 55, "weight": 0.6, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_220", "text": "你花了一整个周末装一个柜子，最后剩下三颗螺丝不知道该放哪，但柜子居然很稳。", "domain": "misc", "valence": 1, "min_age": 20, "max_age": 65, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_221", "text": "你去理发时随口说了句'随便剪剪'，结果理发师认真问了你二十个问题。", "domain": "misc", "valence": 0, "min_age": 15, "max_age": 70, "weight": 0.6, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_222", "text": "你在电梯里遇到老板，四十秒的沉默比一场汇报还漫长。", "domain": "career", "valence": 0, "min_age": 22, "max_age": 55, "weight": 0.7, "trait_bias": {"E": -0.3}, "effects": {"stress": 2}, "source": "handmade"},
 {"id": "evt_hm_223", "text": "你熬夜看完了一整部剧，天亮时窗外有鸟叫。你有点空虚，又有点满足。", "domain": "misc", "valence": 0, "min_age": 15, "max_age": 55, "weight": 0.7, "trait_bias": {"C": -0.3}, "effects": {"happiness": 2, "health": -1}, "source": "handmade"},
 {"id": "evt_hm_224", "text": "你把小时候的照片翻拍发给爸妈，他们回了一长串语音，你听了三遍。", "domain": "family", "valence": 2, "min_age": 20, "max_age": 55, "weight": 0.8, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_225", "text": "老家的房子要拆了。你回去拍了很多照片，最后在门口站了很久。", "domain": "family", "valence": -1, "min_age": 25, "max_age": 65, "weight": 0.7, "effects": {"happiness": -4}, "source": "handmade"},
 {"id": "evt_hm_226", "text": "你教爸妈用视频通话，教了七遍。第八遍他们主动打过来了。", "domain": "family", "valence": 2, "min_age": 22, "max_age": 55, "weight": 0.8, "trait_bias": {"A": 0.3}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_227", "text": "亲戚来家里做客，临走时硬塞给你一袋自家种的菜，后备箱都装不下。", "domain": "family", "valence": 1, "min_age": 20, "max_age": 70, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_228", "text": "你在项目里第一次说了'不'，紧张了一整晚，第二天发现什么也没发生。", "domain": "career", "valence": 1, "min_age": 22, "max_age": 50, "weight": 0.7, "trait_bias": {"A": -0.3}, "effects": {"happiness": 4, "stress": -3}, "source": "handmade"},
 {"id": "evt_hm_229", "text": "你做的东西上线了。没人知道那行不起眼的功能是你写的，但你自己知道。", "domain": "career", "valence": 2, "min_age": 22, "max_age": 55, "weight": 0.7, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_230", "text": "你把简历更新了一遍，看着上面的经历，第一次觉得自己好像也没那么差。", "domain": "career", "valence": 1, "min_age": 22, "max_age": 50, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_231", "text": "你请了一天假，什么也没干，就在家躺着。晚上睡觉前觉得这天没白过。", "domain": "health", "valence": 1, "min_age": 22, "max_age": 60, "weight": 0.7, "effects": {"happiness": 4, "stress": -6}, "source": "handmade"},
 {"id": "evt_hm_232", "text": "你开始随身带一本小本子记东西，两周后翻回去看，发现自己想得最多的是同一件事。", "domain": "growth", "valence": 0, "min_age": 18, "max_age": 60, "weight": 0.6, "trait_bias": {"O": 0.3, "C": 0.3}, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_233", "text": "你重看了一部十年前看过的电影，笑点没变，泪点全变了。", "domain": "growth", "valence": 1, "min_age": 22, "max_age": 70, "weight": 0.7, "trait_bias": {"O": 0.4}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_234", "text": "你在网上课程里认识了一个学习搭子，你们互相监督了整整三个月。", "domain": "growth", "valence": 2, "min_age": 18, "max_age": 50, "weight": 0.6, "trait_bias": {"C": 0.4}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_235", "text": "你终于读完了那本买了三年一直没翻开的书，读完发现它早该被读。", "domain": "growth", "valence": 1, "min_age": 18, "max_age": 75, "weight": 0.6, "trait_bias": {"O": 0.4, "C": 0.3}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_236", "text": "你在雨天躲进一家没去过的咖啡馆，坐了两小时，什么正事也没做。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 65, "weight": 0.7, "trait_bias": {"O": 0.3}, "effects": {"happiness": 3, "stress": -3}, "source": "handmade"},
 {"id": "evt_hm_237", "text": "你把银行卡里的钱数了又数，做了张表，然后关掉表格该干嘛干嘛。", "domain": "finance", "valence": 0, "min_age": 20, "max_age": 55, "weight": 0.7, "effects": {"stress": 2}, "source": "handmade"},
 {"id": "evt_hm_238", "text": "你终于还完了一笔欠了很久的钱，转账成功那一刻长舒了一口气。", "domain": "finance", "valence": 2, "min_age": 22, "max_age": 60, "weight": 0.6, "effects": {"happiness": 6, "stress": -8}, "source": "handmade"},
 {"id": "evt_hm_239", "text": "你给自己买了一件一直舍不得买的东西。没有想象中那么快乐，但也不后悔。", "domain": "finance", "valence": 1, "min_age": 20, "max_age": 60, "weight": 0.7, "effects": {"happiness": 2, "wealth": -3}, "source": "handmade"},
 {"id": "evt_hm_240", "text": "你把手机里三千张照片清理到只剩八百张，删的时候比拍的时候更认真。", "domain": "misc", "valence": 0, "min_age": 20, "max_age": 65, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_241", "text": "你在学校运动会上被推去跑接力，虽然掉了棒，但同学都在笑着喊你的名字。", "domain": "growth", "valence": 1, "min_age": 12, "max_age": 22, "weight": 0.7, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_242", "text": "晚自习你偷偷在课本下面看闲书，被老师发现后，她只说了句'看完记得写作业'。", "domain": "growth", "valence": 1, "min_age": 13, "max_age": 19, "weight": 0.7, "trait_bias": {"O": 0.4}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_243", "text": "你第一次一个人坐火车出远门，全程没敢睡着，也没敢多说话。", "domain": "growth", "valence": 1, "min_age": 15, "max_age": 28, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_244", "text": "你和室友因为一件小事冷战了三天，最后是一份多买的外卖化解的。", "domain": "social", "valence": 1, "min_age": 16, "max_age": 28, "weight": 0.7, "trait_bias": {"A": 0.3}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_245", "text": "你在毕业照里站在最边上。多年后再看，你反倒觉得那个位置挺好。", "domain": "growth", "valence": 1, "min_age": 20, "max_age": 60, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_246", "text": "孩子问了你一个你答不上来的问题，你说'我们一起查'，然后查了一晚上。", "domain": "family", "valence": 2, "min_age": 28, "max_age": 50, "weight": 0.7, "trait_bias": {"O": 0.3}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_247", "text": "你第一次送孩子上学，回头看见他没回头，你在校门口站了一会儿。", "domain": "family", "valence": 1, "min_age": 27, "max_age": 45, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_248", "text": "你和孩子约定各自放下手机一小时，结果两个人大眼瞪小眼，最后一起拼了个拼图。", "domain": "family", "valence": 2, "min_age": 30, "max_age": 50, "weight": 0.6, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_249", "text": "你开始有意识地跟老朋友定期见面，第一次约在了一家你们十年前常去的店。", "domain": "social", "valence": 2, "min_age": 30, "max_age": 65, "weight": 0.7, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_250", "text": "体检报告终于全是'未见异常'，你把它拍下来发给了家里人。", "domain": "health", "valence": 2, "min_age": 25, "max_age": 70, "weight": 0.7, "effects": {"happiness": 5, "stress": -4}, "source": "handmade"},
 {"id": "evt_hm_251", "text": "你戒掉了一个习惯了很多年的东西。头两周很难熬，第三周你都快忘了这回事。", "domain": "health", "valence": 2, "min_age": 20, "max_age": 65, "weight": 0.6, "trait_bias": {"C": 0.5}, "effects": {"happiness": 5, "health": 4}, "source": "handmade"},
 {"id": "evt_hm_252", "text": "你在公园散步时被一群跳广场舞的阿姨拉进了队伍，跳完还被塞了两个橘子。", "domain": "social", "valence": 1, "min_age": 40, "max_age": 80, "weight": 0.7, "trait_bias": {"E": 0.3}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_253", "text": "你开始学着做年轻时没时间学的东西，进度很慢，但没人催你。", "domain": "growth", "valence": 2, "min_age": 50, "max_age": 85, "weight": 0.7, "trait_bias": {"O": 0.5}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_254", "text": "老同学群里有人发了张几十年前的合影，一下午的消息全是'这是谁来着'。", "domain": "social", "valence": 1, "min_age": 45, "max_age": 85, "weight": 0.7, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_255", "text": "你把家里的老物件一件件擦干净摆好，发现每一件背后都能讲半小时。", "domain": "misc", "valence": 1, "min_age": 50, "max_age": 90, "weight": 0.7, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_256", "text": "你在医院陪家人挂号排队，一整天，最后结果是虚惊一场。", "domain": "family", "valence": 0, "min_age": 28, "max_age": 70, "weight": 0.7, "effects": {"stress": 6, "happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_257", "text": "你走了一条没走过的路回家，发现绕远了十分钟，但沿途有条很好看的巷子。", "domain": "misc", "valence": 1, "min_age": 15, "max_age": 75, "weight": 0.7, "trait_bias": {"O": 0.4}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_258", "text": "你养的宠物生病了，你请了假守了两天。它好起来那天，你比谁都开心。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 70, "weight": 0.6, "trait_bias": {"A": 0.4}, "effects": {"happiness": 4, "stress": 3}, "source": "handmade"},
 {"id": "evt_hm_259", "text": "你在一场大雨里没打伞走了一段路，回家洗了个热水澡，居然觉得很痛快。", "domain": "misc", "valence": 1, "min_age": 15, "max_age": 55, "weight": 0.6, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_260", "text": "你把工位收拾得干干净净，第二天上班时心情莫名好了一点。", "domain": "career", "valence": 1, "min_age": 22, "max_age": 60, "weight": 0.6, "trait_bias": {"C": 0.4}, "effects": {"happiness": 2, "stress": -2}, "source": "handmade"},
 {"id": "evt_hm_261", "text": "你终于把拖了很久的那件事做完了。它没有想象中那么难，只是一直很重。", "domain": "growth", "valence": 2, "min_age": 18, "max_age": 70, "weight": 0.8, "trait_bias": {"C": 0.3}, "effects": {"happiness": 5, "stress": -6}, "source": "handmade"},
 {"id": "evt_hm_262", "text": "你被一首很多年没听过的歌击中，站在原地把它听完了。", "domain": "misc", "valence": 1, "min_age": 16, "max_age": 80, "weight": 0.7, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_263", "text": "你在陌生城市迷了路，问了三个人，得到了三个方向，最后自己走对了。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 60, "weight": 0.6, "trait_bias": {"O": 0.3}, "effects": {"happiness": 3}, "source": "handmade"}
]
