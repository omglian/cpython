[
 {"id": "evt_hm_001", "text": "深夜加完班走出写字楼，你发现路边摊的烤红薯和二十年前老家门口的一个味道。", "domain": "career", "valence": 1, "min_age": 22, "max_age": 45, "weight": 1.0, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_002", "text": "部门空降了一位新领导，把你负责了两年的项目整个推翻重来。", "domain": "career", "valence": -1, "min_age": 24, "max_age": 55, "weight": 1.0, "effects": {"happiness": -4, "stress": 8}, "source": "handmade"},
 {"id": "evt_hm_003", "text": "你带的实习生第一次独立完成任务后，特地跑来向你道谢。你忽然理解了当年前辈看你的眼神。", "domain": "career", "valence": 2, "min_age": 26, "max_age": 55, "weight": 0.8, "trait_bias": {"A": 0.4}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_004", "text": "一个猎头突然打来电话，报出的数字让你心跳漏了一拍。你在地铁上想了一路。", "domain": "career", "valence": 1, "min_age": 25, "max_age": 45, "weight": 1.0, "trait_bias": {"O": 0.3}, "effects": {"stress": 3}, "source": "handmade"},
 {"id": "evt_hm_005", "text": "年会抽奖你中了最大的奖，同事起哄让你请客，热闹了一整晚。", "domain": "career", "valence": 1, "min_age": 22, "max_age": 60, "weight": 0.6, "trait_bias": {"E": 0.3}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_010", "text": "你在老同学的婚礼上被安排在'单身桌'，一桌人尴尬地互相敬酒。", "domain": "romance", "valence": -1, "min_age": 24, "max_age": 40, "weight": 0.8, "effects": {"happiness": -3}, "source": "handmade"},
 {"id": "evt_hm_011", "text": "前任在朋友圈晒出了婚纱照。你盯着看了十秒，点了个赞，又默默取消了。", "domain": "romance", "valence": -1, "min_age": 22, "max_age": 45, "weight": 0.8, "trait_bias": {"N": 0.4}, "effects": {"happiness": -4, "stress": 4}, "source": "handmade"},
 {"id": "evt_hm_012", "text": "你和伴侣为了'谁忘了倒垃圾'大吵一架，最后却因为吵得太离谱笑作一团。", "domain": "romance", "valence": 1, "min_age": 22, "max_age": 70, "weight": 1.0, "effects": {"happiness": 3, "stress": -2}, "source": "handmade"},
 {"id": "evt_hm_013", "text": "长辈又一次在饭桌上问起你的感情状况，你笑着扒饭，把话题岔了过去。", "domain": "romance", "valence": -1, "min_age": 24, "max_age": 40, "weight": 1.0, "effects": {"stress": 4}, "source": "handmade"},
 {"id": "evt_hm_020", "text": "父亲的白头发好像一夜之间多了很多。视频通话里他还是那句'家里都好，别担心'。", "domain": "family", "valence": -1, "min_age": 25, "max_age": 60, "weight": 1.2, "effects": {"happiness": -3}, "source": "handmade"},
 {"id": "evt_hm_021", "text": "收拾旧物时翻出小学的日记本，里面写着'长大以后一定要……'。你合上本子坐了很久。", "domain": "family", "valence": 0, "min_age": 25, "max_age": 70, "weight": 0.8, "trait_bias": {"O": 0.3}, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_022", "text": "母亲学会了发语音红包，逢年过节准时发来八块八，附一句'注意身体'。", "domain": "family", "valence": 2, "min_age": 22, "max_age": 60, "weight": 1.0, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_023", "text": "家族群里因为一条养生谣言吵了起来，你打了一大段科普又逐字删掉了。", "domain": "family", "valence": 0, "min_age": 20, "max_age": 60, "weight": 0.8, "trait_bias": {"A": -0.3}, "effects": {"stress": 2}, "source": "handmade"},
 {"id": "evt_hm_024", "text": "孩子第一次开口叫你，你愣了两秒，眼眶一下就热了。", "domain": "family", "valence": 2, "min_age": 24, "max_age": 45, "weight": 1.0, "effects": {"happiness": 8}, "source": "handmade"},
 {"id": "evt_hm_030", "text": "体检报告上多了两个箭头。你把'规律作息'四个字写进了新年计划——第三次。", "domain": "health", "valence": -1, "min_age": 26, "max_age": 60, "weight": 1.2, "effects": {"stress": 4}, "source": "handmade"},
 {"id": "evt_hm_031", "text": "你连续跑步满一百天，体重没怎么变，但爬六楼不喘了。", "domain": "health", "valence": 2, "min_age": 18, "max_age": 65, "weight": 0.8, "trait_bias": {"C": 0.5}, "effects": {"happiness": 4, "health": 3, "stress": -3}, "source": "handmade"},
 {"id": "evt_hm_032", "text": "一场重感冒把你击倒在出租屋里，你烧得迷迷糊糊，第一次认真想到了'一个人'这件事。", "domain": "health", "valence": -1, "min_age": 20, "max_age": 40, "weight": 0.8, "effects": {"happiness": -4, "health": -2}, "source": "handmade"},
 {"id": "evt_hm_033", "text": "你尝试冥想来对抗失眠，结果在第三分钟睡着了。也算成功。", "domain": "health", "valence": 1, "min_age": 20, "max_age": 70, "weight": 0.6, "trait_bias": {"N": 0.4}, "effects": {"stress": -4}, "source": "handmade"},
 {"id": "evt_hm_040", "text": "房东通知涨租的那天，你打开了买房计算器，按了几下又默默关掉。", "domain": "finance", "valence": -1, "min_age": 22, "max_age": 40, "weight": 1.0, "effects": {"happiness": -3, "stress": 5}, "source": "handmade"},
 {"id": "evt_hm_041", "text": "你尘封多年的旧手办在二手平台意外卖出了高价，够吃一个月的午饭。", "domain": "finance", "valence": 1, "min_age": 18, "max_age": 45, "weight": 0.6, "effects": {"happiness": 3, "wealth": 5}, "source": "handmade"},
 {"id": "evt_hm_042", "text": "你跟风买的基金绿了一整年，你决定把 App 卸载，眼不见心不烦。", "domain": "finance", "valence": -1, "min_age": 22, "max_age": 55, "weight": 0.8, "effects": {"happiness": -2, "wealth": -5}, "source": "handmade"},
 {"id": "evt_hm_043", "text": "你第一次认真记账，月底看到'奶茶'分类的总额时沉默了。", "domain": "finance", "valence": 0, "min_age": 18, "max_age": 40, "weight": 0.8, "trait_bias": {"C": 0.3}, "effects": {"stress": 1}, "source": "handmade"},
 {"id": "evt_hm_050", "text": "你报名的线上课程终于学完了最后一节。结业证书是电子的，成就感是真实的。", "domain": "growth", "valence": 2, "min_age": 18, "max_age": 60, "weight": 0.8, "trait_bias": {"C": 0.4, "O": 0.3}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_051", "text": "你在书店站着读完了一本书的一半，最后还是把它买了下来——为了另一半。", "domain": "growth", "valence": 1, "min_age": 15, "max_age": 75, "weight": 0.8, "trait_bias": {"O": 0.5}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_052", "text": "你心血来潮学做一道硬菜，厨房像被打劫过，但味道意外地不错。", "domain": "growth", "valence": 1, "min_age": 18, "max_age": 70, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_053", "text": "深夜你把学了三个月的吉他弹给自己听，跑调跑得很自由。", "domain": "growth", "valence": 1, "min_age": 15, "max_age": 60, "weight": 0.6, "trait_bias": {"O": 0.4}, "effects": {"happiness": 3, "stress": -2}, "source": "handmade"},
 {"id": "evt_hm_060", "text": "多年没联系的好友突然发来消息：'在吗，路过你的城市，见一面？'你们聊到了打烊。", "domain": "social", "valence": 2, "min_age": 20, "max_age": 70, "weight": 1.0, "trait_bias": {"E": 0.3}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_061", "text": "你被拉进了第七个工作群。你把手机调成静音，世界清净了三分钟。", "domain": "social", "valence": -1, "min_age": 22, "max_age": 55, "weight": 0.8, "trait_bias": {"E": -0.4}, "effects": {"stress": 3}, "source": "handmade"},
 {"id": "evt_hm_062", "text": "小区楼下的流浪猫开始蹭你的裤脚。你顺手买了猫粮，从此多了一份'责任'。", "domain": "social", "valence": 1, "min_age": 15, "max_age": 80, "weight": 0.8, "trait_bias": {"A": 0.4}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_063", "text": "你鼓起勇气参加了一场陌生人饭局，全程话不多，但回家路上觉得没那么孤单了。", "domain": "social", "valence": 1, "min_age": 18, "max_age": 50, "weight": 0.6, "trait_bias": {"E": -0.3}, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_070", "text": "你在阳台种的小番茄结果了，一共三颗。你郑重其事地拍照留念。", "domain": "misc", "valence": 1, "min_age": 18, "max_age": 90, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_071", "text": "台风夜停电，你点着手机手电筒吃泡面，忽然觉得这一刻也挺浪漫。", "domain": "misc", "valence": 1, "min_age": 15, "max_age": 80, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_072", "text": "你错过了末班车，步行四十分钟回家，路上把这几年的事想了一遍。", "domain": "misc", "valence": 0, "min_age": 18, "max_age": 60, "weight": 0.8, "effects": {"stress": -2}, "source": "handmade"},
 {"id": "evt_hm_073", "text": "手机相册自动生成了'五年前的今天'。你看着照片里的自己，一时说不清是怀念还是感慨。", "domain": "misc", "valence": 0, "min_age": 22, "max_age": 80, "weight": 0.8, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_074", "text": "你在旧衣服口袋里摸出一张没刮的彩票。刮开：谢谢惠顾。你笑了一下，扔进了垃圾桶。", "domain": "misc", "valence": 0, "min_age": 18, "max_age": 80, "weight": 0.6, "source": "handmade"},
 {"id": "evt_hm_080", "text": "凌晨三点你还清醒着，给自己列了一张'三十岁之前要做的事'清单，然后安心睡去。", "domain": "growth", "valence": 1, "min_age": 20, "max_age": 29, "weight": 0.8, "trait_bias": {"C": 0.3, "N": 0.2}, "effects": {"stress": -2}, "source": "handmade"},
 {"id": "evt_hm_081", "text": "你参加了人生第一场马拉松，在最后一公里几乎是走过终点的，但奖牌货真价实。", "domain": "health", "valence": 2, "min_age": 18, "max_age": 55, "weight": 0.6, "trait_bias": {"C": 0.4, "E": 0.2}, "effects": {"happiness": 6, "health": 2}, "source": "handmade"},
 {"id": "evt_hm_082", "text": "退休后的第一个工作日早晨，你习惯性地七点醒来，然后想起不用上班，又幸福地睡了回去。", "domain": "career", "valence": 2, "min_age": 60, "max_age": 75, "weight": 1.0, "effects": {"happiness": 5, "stress": -5}, "source": "handmade"},
 {"id": "evt_hm_083", "text": "你开始教社区的老人用智能手机，他们叫你'小老师'，虽然你也不年轻了。", "domain": "social", "valence": 2, "min_age": 45, "max_age": 80, "weight": 0.8, "trait_bias": {"A": 0.4}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_084", "text": "孙辈拿着作业来问你问题，你偷偷在另一个房间搜索了答案，保住了长辈的威严。", "domain": "family", "valence": 2, "min_age": 55, "max_age": 90, "weight": 0.8, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_085", "text": "高中晚自习停电的那晚，整栋楼的人在黑暗里欢呼。多年后你还会想起那片星星点点的手机光。", "domain": "growth", "valence": 2, "min_age": 15, "max_age": 19, "weight": 0.8, "effects": {"happiness": 4}, "source": "handmade"}
]
