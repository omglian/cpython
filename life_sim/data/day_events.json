  "slot": "dawn",
  "text": "出门前照镜子，发现自己黑眼圈重得像没睡。事实上确实没睡好。",
  "weight": 0.7,
  "requires": {
   "energy_below": 45
  }
 },
 {
  "id": "d_dawn_15",
  "slot": "dawn",
  "text": "你早起去跑了两公里，回来出了一身汗，整个人都是热的。",
