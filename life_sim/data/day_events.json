[
 {
  "id": "d_dawn_01",
  "slot": "dawn",
  "text": "闹钟响的时候天刚亮，你在被窝里跟自己讨价还价了十分钟。",
  "weight": 1.2,
  "effects": {
   "energy": -2
  }
 },
 {
  "id": "d_dawn_02",
  "slot": "dawn",
  "text": "你六点就自然醒了，窗外还很安静，你躺着听了一会儿早班公交的声音。",
  "weight": 0.8,
  "trait_bias": {
   "C": 0.5
  },
  "effects": {
   "mood": 3
  }
 },
 {
  "id": "d_dawn_03",
  "slot": "dawn",
  "text": "早饭是昨晚剩的半个面包和一杯热水，站在厨房三分钟解决。",
  "weight": 1.0,
  "requires": {
   "rest_day": false
  }
 },
 {
  "id": "d_dawn_04",
  "slot": "dawn",
  "text": "你煎了个蛋，蛋黄没破，这让你觉得今天大概会顺利。",
  "weight": 0.8,
  "effects": {
   "mood": 3
  }
 },
 {
  "id": "d_dawn_05",
  "slot": "dawn",
  "text": "出门时发现忘带钥匙，又折回去一趟，电梯等了很久。",
  "weight": 0.7,
  "effects": {
   "mood": -3,
   "stress": 3
  }
 },
 {
  "id": "d_dawn_06",
  "slot": "dawn",
  "text": "地铁挤得转不过身，你保持着一个别扭的姿势站了四十分钟。",
  "weight": 1.0,
  "requires": {
   "rest_day": false
  },
  "effects": {
   "energy": -6
  }
 },
 {
  "id": "d_dawn_07",
  "slot": "dawn",
  "text": "路口的早点摊排了长队，你还是排了，热豆浆握在手里那一刻觉得值。",
  "weight": 0.8,
  "effects": {
   "mood": 4
  }
 },
 {
  "id": "d_dawn_08",
  "slot": "dawn",
  "text": "外面下着雨，你在门口站了半分钟，还是回屋拿了伞。",
  "weight": 0.9,
  "requires": {
   "weather": "雨"
  }
 },
 {
  "id": "d_dawn_09",
  "slot": "dawn",
  "text": "冷空气一下子灌进领口，你把脖子缩进围巾里，走得飞快。",
  "weight": 0.9,
  "requires": {
   "season": "冬"
  }
 },
 {
  "id": "d_dawn_10",
  "slot": "dawn",
  "text": "楼下的樱花开了一半，你站在树下看了一会儿，拍了张照。",
  "weight": 0.7,
  "requires": {
   "season": "春"
  },
  "effects": {
   "mood": 3
  }
 },
 {
  "id": "d_dawn_11",
  "slot": "dawn",
  "text": "你睡到自然醒，看了眼时间，又心安理得地翻了个身。",
  "weight": 1.2,
  "requires": {
   "rest_day": true
  },
  "effects": {
   "energy": 5,
   "mood": 4
  }
 },
 {
  "id": "d_dawn_12",
  "slot": "dawn",
  "text": "醒来第一件事是摸手机，刷了二十分钟才想起来该起床了。",
  "weight": 1.0,
  "trait_bias": {
   "C": -0.4
  },
  "effects": {
   "energy": -3
  }
 },
 {
  "id": "d_dawn_13",
  "slot": "dawn",
  "text": "你实在起不来，请了半天假，然后又睡了回去。",
  "weight": 0.4,
  "requires": {
   "energy_below": 30
  },
  "effects": {
   "energy": 12,
   "mood": -2
  }
 },
 {
