[
 {"id": "evt_hm_100", "text": "早高峰的地铁把你挤成了一张纸，到公司才发现工牌反着挂了一上午。", "domain": "career", "valence": 0, "min_age": 22, "max_age": 55, "weight": 0.8, "effects": {"stress": 2}, "source": "handmade"},
 {"id": "evt_hm_101", "text": "你在例会上鼓起勇气提了个想法，居然被采纳了。散会后你在工位上偷偷握了下拳。", "domain": "career", "valence": 2, "min_age": 22, "max_age": 50, "weight": 0.8, "trait_bias": {"E": -0.2}, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_102", "text": "电脑在交付前夜蓝屏了。你对着进度条祈祷的样子，虔诚得像个信徒。", "domain": "career", "valence": -1, "min_age": 20, "max_age": 55, "weight": 0.8, "effects": {"stress": 6}, "source": "handmade"},
 {"id": "evt_hm_103", "text": "食堂阿姨今天多给你打了一勺菜，还冲你笑了笑。这一天好像都顺了起来。", "domain": "career", "valence": 1, "min_age": 18, "max_age": 60, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_104", "text": "离职的同事把工位上的绿萝托付给你。你接过来的时候，突然有点舍不得这个人。", "domain": "career", "valence": 0, "min_age": 22, "max_age": 55, "weight": 0.8, "effects": {"happiness": -1}, "source": "handmade"},
 {"id": "evt_hm_105", "text": "你熬了三个通宵赶完的方案，客户一句'先放放'就没了下文。", "domain": "career", "valence": -1, "min_age": 22, "max_age": 50, "weight": 0.8, "effects": {"happiness": -3, "stress": 5}, "source": "handmade"},
 {"id": "evt_hm_110", "text": "你定了五个起床闹钟，最终在第五个响起后的二十分钟起床，动作行云流水。", "domain": "health", "valence": 0, "min_age": 15, "max_age": 45, "weight": 0.8, "trait_bias": {"C": -0.4}, "effects": {"stress": 1}, "source": "handmade"},
 {"id": "evt_hm_111", "text": "体重秤的数字让你决定今晚只吃沙拉。夜里十一点，你站在冰箱前输掉了这场战争。", "domain": "health", "valence": 0, "min_age": 16, "max_age": 55, "weight": 0.8, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_112", "text": "你第一次去做心理咨询，出门前紧张得转了三圈。结束时你在楼下买了杯热的，觉得自己迈出了很大一步。", "domain": "health", "valence": 2, "min_age": 18, "max_age": 60, "weight": 0.6, "trait_bias": {"N": 0.5}, "effects": {"happiness": 4, "stress": -6}, "source": "handmade"},
 {"id": "evt_hm_113", "text": "牙疼拖了两周，你终于坐上了牙科的椅子。医生说：再晚来一周就麻烦了。", "domain": "health", "valence": -1, "min_age": 18, "max_age": 70, "weight": 0.8, "effects": {"health": -1, "stress": 3}, "source": "handmade"},
 {"id": "evt_hm_114", "text": "你办了张健身卡。教练的朋友圈里，你的名字出现在'本月最久未到店'名单上。", "domain": "health", "valence": 0, "min_age": 18, "max_age": 55, "weight": 0.8, "trait_bias": {"C": -0.4}, "effects": {"happiness": -1}, "source": "handmade"},
 {"id": "evt_hm_120", "text": "外卖比预计早到了二十分钟，你觉得今天是被生活温柔以待的一天。", "domain": "finance", "valence": 1, "min_age": 18, "max_age": 50, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_121", "text": "你清理了一遍订阅扣费，发现有个会员已经默默续了两年，你一次都没用过。", "domain": "finance", "valence": 0, "min_age": 20, "max_age": 55, "weight": 0.8, "effects": {"wealth": 2, "stress": 1}, "source": "handmade"},
 {"id": "evt_hm_122", "text": "双十一你清空了购物车，第二天又默默退掉了一半。你为自己的理性感到骄傲，大概。", "domain": "finance", "valence": 0, "min_age": 18, "max_age": 50, "weight": 0.8, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_123", "text": "你在旧外套里摸出一张一百块。这笔'意外之财'带来的快乐，远超它的面值。", "domain": "finance", "valence": 1, "min_age": 15, "max_age": 80, "weight": 0.6, "effects": {"happiness": 3, "wealth": 1}, "source": "handmade"},
 {"id": "evt_hm_130", "text": "你妈打视频过来只是想给你看阳台新开的花。你们聊了四十分钟的'没什么事'。", "domain": "family", "valence": 2, "min_age": 20, "max_age": 60, "weight": 1.0, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_131", "text": "回老家时你发现自己的房间还保持着上学时的样子，书桌上的贴纸都没撕。", "domain": "family", "valence": 1, "min_age": 20, "max_age": 50, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_132", "text": "爸妈开始转发'年轻人要多喝热水'给你，你一边吐槽一边把水烧上了。", "domain": "family", "valence": 1, "min_age": 18, "max_age": 45, "weight": 0.8, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_133", "text": "全家福里你终于站到了后排最高的位置，而爷爷坐在了最中间。", "domain": "family", "valence": 1, "min_age": 16, "max_age": 40, "weight": 0.6, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_140", "text": "群里组局的消息刷了九十九条，你从'在吗'开始看，看到'下次一定'结束。", "domain": "social", "valence": 0, "min_age": 18, "max_age": 45, "weight": 0.8, "trait_bias": {"E": -0.3}, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_141", "text": "你帮邻居收了一次快递，从此你们在电梯里从点头之交升级成了'哎最近怎么样'。", "domain": "social", "valence": 1, "min_age": 20, "max_age": 70, "weight": 0.8, "trait_bias": {"A": 0.3}, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_142", "text": "理发师问'剪短一点可以吧'，你说可以。走出店门时你决定这个月都戴帽子。", "domain": "misc", "valence": -1, "min_age": 15, "max_age": 60, "weight": 0.8, "effects": {"happiness": -2}, "source": "handmade"},
 {"id": "evt_hm_143", "text": "你养的多肉又双叒叕死了。植物界一致认为你的爱太沉重。", "domain": "misc", "valence": 0, "min_age": 18, "max_age": 60, "weight": 0.6, "effects": {"happiness": -1}, "source": "handmade"},
 {"id": "evt_hm_144", "text": "深夜楼下有人弹吉他唱歌，唱得一般，但你听完了整首，还差点鼓掌。", "domain": "misc", "valence": 1, "min_age": 15, "max_age": 70, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_145", "text": "你把手机屏幕时间报告截图发给朋友，配文'我有病'。朋友回了他的截图：比你多两小时。", "domain": "misc", "valence": 0, "min_age": 15, "max_age": 45, "weight": 0.8, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_146", "text": "第一场雪落下来的时候，你正好在窗边。你给三个人发了消息：'下雪了。'", "domain": "misc", "valence": 1, "min_age": 15, "max_age": 80, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_147", "text": "你在早餐摊前排了十分钟队，就为了那一口刚出锅的。摊主记得你不要香菜。", "domain": "misc", "valence": 1, "min_age": 16, "max_age": 80, "weight": 0.6, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_148", "text": "打车遇到一位话痨司机，下车时你居然听完了他半辈子的故事，还有点意犹未尽。", "domain": "social", "valence": 1, "min_age": 18, "max_age": 70, "weight": 0.6, "trait_bias": {"O": 0.3}, "effects": {"happiness": 2}, "source": "handmade"},
 {"id": "evt_hm_149", "text": "你收藏了第一百零一篇'如何早起'的文章，然后关掉手机继续睡了。", "domain": "growth", "valence": 0, "min_age": 16, "max_age": 45, "weight": 0.8, "trait_bias": {"C": -0.3}, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_150", "text": "旧手机在抽屉里开机成功，锁屏壁纸和聊天记录像一封没寄出的信。", "domain": "misc", "valence": 0, "min_age": 20, "max_age": 60, "weight": 0.6, "effects": {"happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_151", "text": "考试周的图书馆一座难求，你占到了靠窗的位置，阳光晒得书页发亮。", "domain": "growth", "valence": 1, "min_age": 15, "max_age": 26, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_152", "text": "宿舍夜谈会从'明天吃什么'聊到'人活着是为了什么'，最后在此起彼伏的呼噜声中散会。", "domain": "growth", "valence": 1, "min_age": 16, "max_age": 24, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_153", "text": "你在课堂上被点名回答问题，站起来的瞬间大脑一片空白，坐下的瞬间答案全想起来了。", "domain": "growth", "valence": 0, "min_age": 12, "max_age": 24, "weight": 0.8, "effects": {"stress": 2}, "source": "handmade"},
 {"id": "evt_hm_154", "text": "毕业多年后你梦见还有一门课没考。惊醒后你花了整整一分钟说服自己已经毕业了。", "domain": "misc", "valence": 0, "min_age": 25, "max_age": 60, "weight": 0.8, "effects": {"stress": 1}, "source": "handmade"},
 {"id": "evt_hm_155", "text": "你在公园下棋赢了一位大爷，大爷不服，摆子再来。你们杀到了路灯亮起。", "domain": "social", "valence": 1, "min_age": 50, "max_age": 90, "weight": 0.8, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_156", "text": "晨练的队伍里你的动作总慢半拍，但没人介意，音乐照放，太阳照升。", "domain": "health", "valence": 1, "min_age": 55, "max_age": 90, "weight": 0.8, "effects": {"happiness": 3, "health": 1}, "source": "handmade"},
 {"id": "evt_hm_157", "text": "你学会了用手机挂号，帮同龄的老朋友也挂了一个。他非要请你吃早茶。", "domain": "social", "valence": 2, "min_age": 55, "max_age": 90, "weight": 0.8, "trait_bias": {"O": 0.3}, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_158", "text": "阳台的花开了第二茬。你搬了把椅子坐在旁边，什么也不做，就看着。", "domain": "misc", "valence": 1, "min_age": 50, "max_age": 95, "weight": 0.8, "effects": {"happiness": 3, "stress": -3}, "source": "handmade"},
 {"id": "evt_hm_159", "text": "你把这些年的照片整理成了相册，翻到最后一页时，窗外刚好日落。", "domain": "misc", "valence": 1, "min_age": 55, "max_age": 95, "weight": 0.6, "effects": {"happiness": 4}, "source": "handmade"},
 {"id": "evt_hm_160", "text": "台灯下你陪孩子写作业，一道数学题你们俩都不会，最后一起搜了答案并约定保密。", "domain": "family", "valence": 1, "min_age": 28, "max_age": 50, "weight": 0.8, "effects": {"happiness": 3}, "source": "handmade"},
 {"id": "evt_hm_161", "text": "孩子把学校发的小红花贴在了你的手机壳上，说'给你也发一朵'。", "domain": "family", "valence": 2, "min_age": 26, "max_age": 45, "weight": 0.8, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_162", "text": "你在家长群里潜水一年，今天第一次发言，秒收三个'收到'。", "domain": "family", "valence": 0, "min_age": 28, "max_age": 50, "weight": 0.6, "trait_bias": {"E": -0.3}, "effects": {"stress": 1}, "source": "handmade"},
 {"id": "evt_hm_163", "text": "加完班回家，你在楼下坐了十分钟才上楼——你想把疲惫留在车里，把笑脸带回家。", "domain": "family", "valence": 0, "min_age": 26, "max_age": 55, "weight": 0.8, "trait_bias": {"A": 0.3}, "effects": {"stress": 2, "happiness": 1}, "source": "handmade"},
 {"id": "evt_hm_164", "text": "你和多年的老友约了顿火锅，从毕业聊到房贷，从头发聊到体检报告，谁也没提'改天再约'。", "domain": "social", "valence": 2, "min_age": 28, "max_age": 60, "weight": 0.8, "effects": {"happiness": 5}, "source": "handmade"},
 {"id": "evt_hm_165", "text": "雨天你没带伞，便利店老板借了你一把，说'下次路过还我就行'。你后来专程去还了伞，还买了瓶水。", "domain": "social", "valence": 2, "min_age": 15, "max_age": 80, "weight": 0.6, "trait_bias": {"A": 0.3}, "effects": {"happiness": 4}, "source": "handmade"}
]
